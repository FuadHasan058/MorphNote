<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Drag to reorder"
        android:padding="2dp"
        android:src="@drawable/ic_drag_handle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/code_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Code header bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="@color/code_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Code"
                    android:src="@drawable/ic_code"
                    app:tint="@color/code_header_text" />

                <TextView
                    android:id="@+id/tvCodeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="CODE / SNIPPET"
                    android:textColor="@color/code_header_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Code editor input -->
            <EditText
                android:id="@+id/etCodeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="@string/code_hint"
                android:inputType="textMultiLine|textNoSuggestions"
                android:lineSpacingExtra="3dp"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="@color/code_text"
                android:textColorHint="#6E7681"
                android:textSize="13sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/delete"
        android:padding="4dp"
        android:src="@drawable/ic_delete" />

</LinearLayout>

