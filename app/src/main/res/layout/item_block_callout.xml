<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Drag to reorder"
        android:padding="2dp"
        android:src="@drawable/ic_drag_handle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCallout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/callout_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/callout_border"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivCalloutIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="6dp"
                android:contentDescription="Callout"
                android:src="@drawable/ic_callout" />

            <EditText
                android:id="@+id/etCalloutContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/callout_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="2dp"
                android:padding="4dp"
                android:textColor="@color/callout_text"
                android:textColorHint="#B45309"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivOpenLink"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open Link"
                android:padding="4dp"
                android:src="@drawable/ic_open_in_new"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/delete"
        android:padding="4dp"
        android:src="@drawable/ic_delete" />

</LinearLayout>

