<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Drag to reorder"
        android:padding="2dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCallout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/callout_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/callout_border"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivCalloutIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:contentDescription="Callout"
                android:src="@drawable/ic_callout" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Headline / Title -->
                <EditText
                    android:id="@+id/etCalloutTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Callout Title / Key Idea"
                    android:inputType="textCapWords"
                    android:maxLines="2"
                    android:padding="2dp"
                    android:textIsSelectable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/callout_text"
                    android:textColorHint="@color/callout_hint"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Body / Details -->
                <EditText
                    android:id="@+id/etCalloutContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@null"
                    android:hint="@string/callout_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:lineSpacingExtra="2dp"
                    android:padding="2dp"
                    android:textIsSelectable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="@color/callout_text"
                    android:textColorHint="@color/callout_hint"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivOpenLink"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open Link"
                android:padding="4dp"
                android:src="@drawable/ic_open_in_new"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/delete"
        android:padding="4dp"
        android:src="@drawable/ic_delete"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
